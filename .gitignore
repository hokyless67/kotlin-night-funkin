# compiles src/main/kotlin and never reads these.
/commonMain/
/jvmMain/
/META-INF/

# ---- Upstream Friday Night Funkin' sources & assets -------------------------
# Reference material and runtime assets. The Kotlin port does not need these to
# build; keep them locally only.
/Funkin-0.8.6-Source/
